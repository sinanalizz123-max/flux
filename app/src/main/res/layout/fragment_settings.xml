<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/deep_black">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Protection"
        android:textColor="@color/classic_red"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_vpn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VPN / Firewall"
        android:textColor="@color/leica_white"
        android:textSize="18sp"
        android:checked="false"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:paddingStart="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_secure"
            app:tint="@color/leica_gray"
            android:layout_gravity="center_vertical"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_adblock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ad Blocker"
            android:textColor="@color/leica_white"
            android:textSize="18sp"
            android:layout_marginStart="16dp"
            android:enabled="false"
            android:alpha="0.4"/>
    </LinearLayout>
</LinearLayout>
